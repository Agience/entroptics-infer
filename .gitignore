__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# Corpora are either generated by the experiment that consumes them, from a stated process and a
# stated seed, or fetched by it with the SHA-256 of what it received recorded. Either way the
# generator or the digest is the record and the bytes are not; this directory is a cache.
research/corpora/

# `research/results/` is tracked, not ignored. Those files are the evidence every row of CLAIMS.md cites,
# and a paper whose raw output is untracked is a paper whose numbers cannot be checked against
# anything. They are small, and they are the record of what was actually measured.
# A smoke or quick run of an experiment writes beside its record and is not evidence for anything.
research/results/*.smoke.json
research/results/*.quick.json

# Lean build output (lake)
.lake/

# TeX intermediates of typeset/build_paper.py (PAPER.tex and PAPER.pdf are tracked)
/research/*.aux
/research/*.log
/research/*.out
/research/*.toc
/research/*.xdv
/research/*.fls
/research/*.fdb_latexmk
/research/*.synctex.gz
/research/typeset/__pycache__/
